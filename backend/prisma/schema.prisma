// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
	provider = "prisma-client"
	output = "./generated"
	engineType = "client"
	runtime = "bun"
}

datasource db {
	provider = "postgresql"
}

// Define schema
model user {
  id        String   @id @default(uuid())
  email     String   @unique
  provider  AuthProvider
  name      String
  supabase_id String  @unique
  conversations conversation[]
  credits     Int    @default(100)
  lastCreditRefillAt DateTime?
}

model conversation {
  id       String   @id @default(uuid())
  title    String?
  slug     String 
  userId   String
  messages Message[]
  user     user     @relation(fields: [userId], references: [id])  
}

// Shared cache for Tavily responses. Results are public web-search data, not
// user-specific data, so they can safely be reused across users within the TTL.
model webSearchCache {
  id              String   @id @default(uuid())
  normalizedQuery String   @unique
  originalQuery   String
  results         Json
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model Message {
  id             Int   @id @default(autoincrement())
  conversationId String
  content        String
  role           MessageRole
  sources        Json?
  followUps      Json?
  conversation   conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime @default(now())
}

enum MessageRole {
  User
  Assistant
}

enum AuthProvider {
  Google
  Github
}
