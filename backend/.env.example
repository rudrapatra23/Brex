PORT=3001
# Comma-separated list of allowed browser origins. Requests from any other
# origin are rejected, so deployed frontend URLs must be listed here.
CORS_ORIGIN=http://localhost:3000
TAVILY_API_KEY=your_tavily_api_key
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
SUPABASE_API_SECRET=your_supabase_service_role_secret
DAILY_REFILL_CREDITS=50
MODEL_TIMEOUT_MS=30000
